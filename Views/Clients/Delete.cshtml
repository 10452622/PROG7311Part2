@model PROG7311Part2.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<h2>Delete Client</h2>

<h4>Are you sure you want to delete this client?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Contact Details</dt>
        <dd class="col-sm-10">@Model.ContactDetails</dd>

        <dt class="col-sm-2">Region</dt>
        <dd class="col-sm-10">@Model.Region</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClientId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
