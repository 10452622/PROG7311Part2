@model IEnumerable<PROG7311Part2.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<h2>Clients</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Client</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Contact Details</th>
            <th>Region</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var client in Model)
{
    <tr>
        <td>@client.Name</td>
        <td>@client.ContactDetails</td>
        <td>@client.Region</td>
        <td>
            <a asp-action="Edit" asp-route-id="@client.ClientId" class="btn btn-sm btn-secondary">Edit</a>
            <a asp-action="Delete" asp-route-id="@client.ClientId" class="btn btn-sm btn-danger">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>
