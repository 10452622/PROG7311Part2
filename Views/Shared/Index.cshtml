<div class="card">
    <h2 style="color: var(--pastel-blue)">Service Requests</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Cost</th>
                <th>Contract</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Cost</td>
                    <td>@item.ContractId</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ServiceRequestId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ServiceRequestId" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>