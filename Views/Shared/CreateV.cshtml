@model PROG7311Part2.Models.ServiceRequest
<div class="card">
    <h2 style="color: var(--pastel-pink)">Create Service Request</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (ViewBag.Errors != null)
        {
            <div class="alert alert-danger">
                <ul>
                    @foreach (var err in (IEnumerable<string>)ViewBag.Errors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <div class="form-group">
            <label asp-for="Description" class="control-label">Description</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Cost" class="control-label">Cost (USD)</label>
            <input asp-for="Cost" class="form-control" />
            <span asp-validation-for="Cost" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ContractId" class="control-label">Contract</label>
            <select asp-for="ContractId" class="form-control" asp-items="(SelectList)ViewBag.ContractId">
                <option value="">-- Select contract --</option>
            </select>
            <span asp-validation-for="ContractId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="control-label">Attachment (PDF)</label>
            <input type="file" name="file" accept=".pdf" class="form-control" />
            <small class="form-text text-muted">Only .pdf files are allowed. Leave empty if not attaching a file.</small>
        </div>

        @if (!ViewBag.HasContracts)
        {
            <div class="alert alert-warning">
                No contracts found. Please create a contract first.
                <a asp-controller="Contracts" asp-action="Create">Create Contract</a>
            </div>
        }

        <br />
        <button type="submit" class="btn btn-success">Save</button>
    </form>
</div>
